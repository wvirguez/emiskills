{
  "name": "emilia-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "prisma db seed",
    "db:seed:prod": "tsx prisma/seed.production.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "hotmart:sync": "tsx --conditions=react-server scripts/hotmart-sync.ts",
    "hotmart:check": "tsx --conditions=react-server scripts/hotmart-check.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
